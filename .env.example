# Copier ce fichier en .env.local et remplir les valeurs.
# Ne jamais commiter .env.local (il est ignoré par git).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (Anthropic)
ANTHROPIC_API_KEY=

# WhatsApp Business API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ManyChat (Instagram)
MANYCHAT_API_KEY=
MANYCHAT_PAGE_ID=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# SumUp
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# n8n
N8N_WEBHOOK_BASE_URL=
N8N_API_KEY=

# Open-Meteo Marine (API publique, pas de clé — Carnon)
OPEN_METEO_LAT=43.5511
OPEN_METEO_LON=3.9806

# Resend (email)
RESEND_API_KEY=

# Jarvis dashboard (Manager en vocal) — secret partagé entre app/api/jarvis
# et la fonction Edge dashboard-agent. Génère une valeur aléatoire longue.
DASHBOARD_AGENT_SECRET=

# Baileys WhatsApp service (Railway)
BAILEYS_SERVICE_URL=https://your-service.railway.app
